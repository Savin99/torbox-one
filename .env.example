# Create the bot through @BotFather and paste its HTTP API token below.
TELEGRAM_BOT_TOKEN=replace_me

# Optional fallback key for the bot owner (TorBox → Settings → API Keys).
# Other users connect their own keys in the bot's private chat with /connect.
TORBOX_API_KEY=replace_me

# Administrator Telegram ID (a positive number).
OWNER_TELEGRAM_ID=replace_me

# Let other people use the bot with their own TorBox API keys.
MULTI_USER_ENABLED=true

# Direct NNM-Club provider. Keep enabled as a fallback even with Prowlarr.
NNM_ENABLED=true

# Optional multi-indexer search. Leave both blank to use only NNM-Club.
PROWLARR_URL=
PROWLARR_API_KEY=

# Optional comma-separated indexer IDs. Blank means all enabled indexers.
PROWLARR_INDEXER_IDS=

# Optional: enables inline movie cards with posters, year, rating and genres.
# Obtain a key from https://kinopoiskapiunofficial.tech
KINOPOISK_API_KEY=

# Optional display name applied automatically at startup (maximum 64 characters).
TELEGRAM_BOT_NAME="TorBox • Личный пульт"

# Forward new notifications from the TorBox notification feed to Telegram.
TORBOX_NOTIFICATIONS_ENABLED=true

# TorBox notification polling interval in seconds (minimum: 30).
NOTIFICATION_POLL_SECONDS=60

# Optional paths. systemd overrides both with /var/lib/torbox-telegram-bot/*.
# STATE_PATH=state.json
# CREDENTIALS_PATH=credentials.json

# Optional: INFO (default), DEBUG, WARNING
LOG_LEVEL=INFO

# Optional: enables episode stills in the iOS app (Kinopoisk has none).
# Free key from themoviedb.org -> Settings -> API.
TMDB_API_KEY=

# Optional: where the metadata cache lives (default: meta_cache.json next to the code).
META_CACHE_PATH=
