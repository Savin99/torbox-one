[Unit]
Description=TorBox One Search API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
DynamicUser=yes
StateDirectory=torbox-search-api
EnvironmentFile=/etc/torbox-search-api.env
WorkingDirectory=/opt/torbox-one
ExecStart=/opt/torbox-one/.venv-search/bin/uvicorn search_api:app --host 127.0.0.1 --port 18787
Restart=on-failure
RestartSec=5

# Ограничения как у бота: сервис не видит чужие домашние каталоги
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
