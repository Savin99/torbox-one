[Unit]
Description=Multi-user Telegram torrent-search bot for TorBox
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/torbox-telegram-bot
EnvironmentFile=/etc/torbox-telegram-bot.env
Environment=STATE_PATH=/var/lib/torbox-telegram-bot/state.json
Environment=CREDENTIALS_PATH=/var/lib/torbox-telegram-bot/credentials.json
ExecStartPre=+/bin/sh -c 'if [ ! -e /var/lib/torbox-telegram-bot/state.json ] && [ -e /opt/torbox-telegram-bot/initial-state.json ]; then cp /opt/torbox-telegram-bot/initial-state.json /var/lib/torbox-telegram-bot/state.json; chown --reference=/var/lib/torbox-telegram-bot /var/lib/torbox-telegram-bot/state.json; chmod 0600 /var/lib/torbox-telegram-bot/state.json; fi'
ExecStart=/opt/torbox-telegram-bot/.venv/bin/python /opt/torbox-telegram-bot/torbox_tg_bot.py
Restart=always
RestartSec=5
TimeoutStopSec=70
UMask=0077
DynamicUser=true
StateDirectory=torbox-telegram-bot
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
